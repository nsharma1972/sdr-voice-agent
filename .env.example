# Database
DATABASE_URL=postgresql://user:pass@host/sdr_voice

# Vapi
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_WEBHOOK_SECRET=

# LiteLLM (local cluster or any OpenAI-compatible endpoint)
LITELLM_BASE_URL=http://localhost:4000/v1
LITELLM_API_KEY=none

# OpenAI (cloud fallback)
OPENAI_API_KEY=

# Cal.com
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=

# Deepgram (STT — passed to Vapi config)
DEEPGRAM_API_KEY=

# ElevenLabs (TTS — passed to Vapi config)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Sender identity
SENDER_NAME="Your Name"
SENDER_EMAIL=you@yourdomain.com
CAL_LINK=https://cal.com/yourname/discovery

# Email (Resend)
RESEND_API_KEY=

# Review portal
PORTAL_PASSWORD=
PORTAL_SESSION_SECRET=dev-only-secret
PORTAL_HOST=0.0.0.0
PORTAL_PORT=8000

# Admin
ADMIN_TOKEN=

# Signal data sources
SEC_EDGAR_UA="SDR Voice Agent <you@yourdomain.com>"
OPENFDA_API_KEY=
