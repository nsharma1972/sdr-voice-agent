# ── Free stack — minimum required for hackathon demo ────────────────────────

# LiveKit — browser WebRTC transport, no credit card required for the free tier
# Sign up at https://cloud.livekit.io → Project Settings → API Keys
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Groq — free tier LLM, ~200ms latency (recommended)
# Sign up at https://console.groq.com → API Keys
GROQ_API_KEY=

# LiteLLM local cluster — fallback when GROQ_API_KEY is not set
# Run: litellm --config litellm.config.yaml
LITELLM_BASE_URL=http://localhost:4000/v1
LITELLM_API_KEY=none

# Deepgram — free tier (12,000 minutes/year, no credit card)
# Sign up at https://console.deepgram.com
DEEPGRAM_API_KEY=

# TTS uses Deepgram Aura with the same DEEPGRAM_API_KEY.

# ── Optional ─────────────────────────────────────────────────────────────────

# Cal.com — free tier meeting booking
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=

# Sender identity shown in the AI's greeting
SENDER_NAME="Your Name"
SENDER_EMAIL=you@yourdomain.com
CAL_LINK=https://cal.com/yourname/discovery

# ElevenLabs — Flash v2.5 TTS (~75ms TTFB, streaming). Free tier: 10K chars/month.
# Sign up at https://elevenlabs.io → Profile → API Key
# Voice IDs: Rachel=21m00Tcm4TlvDq8ikWAM  Drew=29vD33N1lfxGZTaJeMo4
# Falls back to Deepgram Aura TTS when unset.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# OpenAI — only needed if you want the cloud fallback model (GPT-4o mini)
OPENAI_API_KEY=

# Database — defaults to SQLite (sdr.db) if not set
# DATABASE_URL=postgresql://user:pass@host/sdr_voice

# Email (Resend) — not needed for demo
# RESEND_API_KEY=

# Portal auth
PORTAL_PASSWORD=demo
PORTAL_SESSION_SECRET=dev-only-secret
