# ── Free stack — minimum required for hackathon demo ────────────────────────

# Daily.co — free tier (10K participant-minutes/month)
# Sign up at https://dashboard.daily.co → API keys
DAILY_API_KEY=

# LiteLLM local cluster (OpenAI-compatible)
# Run: litellm --config litellm.config.yaml
LITELLM_BASE_URL=http://localhost:4000/v1
LITELLM_API_KEY=none

# Deepgram — free tier (12,000 minutes/year, no credit card)
# Sign up at https://console.deepgram.com
DEEPGRAM_API_KEY=

# edge-tts (Microsoft Edge TTS) — NO KEY NEEDED, completely free
# Voice: en-US-GuyNeural (set in src/voice/pipeline.py)

# ── Optional ─────────────────────────────────────────────────────────────────

# Cal.com — free tier meeting booking
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=

# Sender identity shown in the AI's greeting
SENDER_NAME="Your Name"
SENDER_EMAIL=you@yourdomain.com
CAL_LINK=https://cal.com/yourname/discovery

# OpenAI — only needed if you want the cloud fallback model (GPT-4o mini)
OPENAI_API_KEY=

# Database — defaults to SQLite (sdr.db) if not set
# DATABASE_URL=postgresql://user:pass@host/sdr_voice

# Email (Resend) — not needed for demo
# RESEND_API_KEY=

# Portal auth
PORTAL_PASSWORD=demo
PORTAL_SESSION_SECRET=dev-only-secret
